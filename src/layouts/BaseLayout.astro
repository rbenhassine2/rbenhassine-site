---
interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Raouf Ben Hassine | Salesforce & Python Developer",
  description = "Salesforce and Python developer: Apex, Lightning, Service Cloud, REST/Bulk integrations, and Django/FastAPI + Postgres backends. Remote from Tunisia (GMT+1).",
  currentPath = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <script is:inline src="/theme.js"></script>
</head>
<body>

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">Raouf Ben Hassine</a>
    <div class="header-right">
      <nav>
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#stack">Stack</a>
        <a href="/blog" class={currentPath === '/blog' ? 'active' : ''}>Blog</a>
        <a href="/cv" class={currentPath === '/cv' ? 'active' : ''}>CV</a>
      </nav>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme">Light</button>
    </div>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="container">© 2026 Raouf Ben Hassine · Tunisia (GMT+1)</div>
</footer>

</body>
</html>
